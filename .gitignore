# Dokumen pegawai (file upload sensitif) - disk 'documents' custom,
# TIDAK boleh pernah ikut ter-commit ke Git. Laravel bawaan tidak
# meng-ignore isi storage/app/ sama sekali, jadi ini proteksi eksplisit.
/storage/app/private/documents/*
!/storage/app/private/documents/.gitkeep

